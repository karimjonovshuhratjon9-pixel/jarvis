# JARVIS OS V2 — local settings. Add your own API key after setup.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_VOICE_NAME=puck
JARVIS_SKIP_CLAP_GATE=1
JARVIS_WAKE_WORD_ENABLED=0
# Optional local openWakeWord model file or built-in name (e.g. hey_jarvis).
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.55
# AI-generated code execution is OFF by default. If enabled, code runs with your Windows account permissions.
JARVIS_ENABLE_CODE_EXECUTION=0
# Optional: set to 1 only after reviewing the exact code you intend to run.
